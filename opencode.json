{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "caelus": {
      "type": "local",
      "command": ["npx", "caelus-mcp"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push*main*": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask",
      "gh pr create*": "ask"
    }
  }
}
